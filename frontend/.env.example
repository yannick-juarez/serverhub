# Frontend API domain configuration
# Local development
VITE_API_ORIGIN=http://localhost:3025
VITE_API_BASE_PATH=/api

# Production example
# VITE_API_ORIGIN=https://your-prod-domain.com
# VITE_API_BASE_PATH=/api

# If frontend and backend are served on the same host via reverse proxy,
# you can keep VITE_API_ORIGIN empty and only use VITE_API_BASE_PATH.
