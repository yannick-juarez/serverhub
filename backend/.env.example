# ─── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_before_production
JWT_EXPIRES_IN=8h

# Admin credentials (hashed at first boot if DB is used, plain for .env seeding)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ─── Databases (optionnel – activer selon besoin) ───────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=

# ─── File browser ──────────────────────────────────────────────────────────────
# Racine accessible via le file browser (mettre '/' pour accès total)
FILES_ROOT=/var/www

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
